@model RealEstateWeb.ViewModels.PropertyImageViewModel
<div asp-validation-summary="All" class="text-danger"></div>
<input type="hidden" asp-for="PropertyImageId" />
<div class="form-group"><label asp-for="PropertyId">Bất động sản</label><select asp-for="PropertyId" asp-items="ViewBag.PropertyId" class="form-control"><option value="0">Chọn bất động sản</option></select></div>
<div class="form-group"><label asp-for="Image">Tải ảnh lên</label><input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><p>JPG, PNG, WebP; tối đa 5 MB.</p></div>
<div class="form-group"><label asp-for="ImageUrl">Hoặc dùng đường dẫn ảnh có sẵn</label><input asp-for="ImageUrl" class="form-control" placeholder="/user/images/hotel_feture_1.jpg" /></div>
<div class="form-group"><label><input asp-for="IsMain" /> Dùng làm ảnh đại diện</label></div>
