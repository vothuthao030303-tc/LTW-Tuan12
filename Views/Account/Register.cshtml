@model RealEstateWeb.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<div class="auth-wrap"><div class="container auth-layout">
    <div class="auth-visual"><img src="~/user/images/image-2.jpg" alt="Không gian sống thoáng đãng — ảnh minh họa" /><div class="auth-visual-copy"><span class="eyebrow" style="color:#d6e9cc">Một khởi đầu mới</span><h2>Hành trình tìm nhà<br />bắt đầu từ đây.</h2><p>Tạo tài khoản và khám phá những lựa chọn phù hợp.</p></div></div>
    <section class="auth-card"><span class="eyebrow">Tham gia RealHome</span><h1>Tạo tài khoản</h1><p>Điền thông tin để bắt đầu.</p>
        <form asp-area="" asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group"><label asp-for="FullName">Họ và tên</label><input asp-for="FullName" autocomplete="name" class="form-control" placeholder="Nhập họ tên của bạn" /></div>
            <div class="form-group"><label asp-for="Email">Địa chỉ email</label><input asp-for="Email" type="email" autocomplete="email" class="form-control" placeholder="ban@example.com" /></div>
            <div class="form-group"><label asp-for="Phone">Số điện thoại</label><input asp-for="Phone" type="tel" autocomplete="tel" class="form-control" placeholder="Số điện thoại liên hệ" /></div>
            <div class="row"><div class="col-md-6 form-group"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="new-password" class="form-control" /></div><div class="col-md-6 form-group"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control" /></div></div>
            <button class="btn btn-primary btn-block btn-lg" type="submit">Tạo tài khoản <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></button>
        </form><div class="auth-caption">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></div>
    </section>
</div></div>
