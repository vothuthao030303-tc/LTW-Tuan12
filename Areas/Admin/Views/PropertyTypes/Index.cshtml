@model IEnumerable<RealEstateWeb.Models.PropertyType>
@{ViewData["Title"]="Loại bất động sản";}<div class="rh-page-head"><div><h3>Loại bất động sản</h3><p>Danh mục phân loại tin đăng.</p></div><a asp-action="Create" class="btn btn-primary">+ Thêm loại</a></div><div class="rh-card"><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th>Tên loại</th><th>Mô tả</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.PropertyTypeId</td><td><strong>@x.TypeName</strong></td><td>@x.Description</td><td><a asp-action="Edit" asp-route-id="@x.PropertyTypeId" class="btn btn-sm btn-default">Sửa</a><form asp-action="Delete" asp-route-id="@x.PropertyTypeId" method="post" style="display:inline"><button class="btn btn-sm btn-danger">Xóa</button></form></td></tr>}</tbody></table></div></div>
