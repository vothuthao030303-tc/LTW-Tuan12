<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Tuan11</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/submission.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="container simple-nav" aria-label="Điều hướng">
            <a class="site-name" asp-area="" asp-controller="Home" asp-action="Index"><span>Tuan12</span></a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a>
            <a asp-area="Admin" asp-controller="Properties" asp-action="Index" class="nav-link">Quản lý bất động sản</a>
        </nav>
    </header>
    <main class="container main-content" id="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container">© @DateTime.Now.Year - Tuan11 - Đồ án Lập trình Web</div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
